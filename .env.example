# remote-claude — environment
#
# Copy to `.env` and adjust. `.env` is never committed; this file is, and it must list EVERY
# variable the code reads, each with a comment saying what it does.
#
# There is no silent default anywhere: a missing or invalid variable stops the process from
# starting, on purpose (docs/architecture/shared/07-repository-layout.md#configuração-e-segredo).
#
# There is deliberately NO variable for the Claude credential. The backend runs as the owner of
# the machine and inherits the login in ~/.claude/.credentials.json — see
# docs/discovery/01-descoberta-claude-agent-sdk.md. If you are about to add one, read that first.

# --- Ports of the local stack --------------------------------------------------------------
# `pnpm dev` binds these fixed ports; `pnpm test:e2e` ignores them and allocates random ones.
# Every port is a variable with a default so both stacks can run side by side.

# Host port the PostgreSQL container publishes.
RC_POSTGRES_PORT=5432

# Host port the Keycloak container publishes; also the issuer host of OIDC_ISSUER below.
RC_KEYCLOAK_PORT=8180

# Bootstrap administrator of the local Keycloak, created on the container's first start. Reaches
# only the admin console at http://localhost:8180 — the realm below is what the product uses.
RC_KEYCLOAK_ADMIN=admin

# Password of that administrator. Local only; the Keycloak container is never exposed publicly.
RC_KEYCLOAK_ADMIN_PASSWORD=admin

# Port the backend listens on.
RC_BACKEND_PORT=3000

# Port the web dev server listens on.
RC_WEB_PORT=5173

# --- PostgreSQL ----------------------------------------------------------------------------

# Owner role of the local database; created on the container's first start.
RC_POSTGRES_USER=remote_claude

# Password of that role. Local only — production credentials come from the host, never from here.
RC_POSTGRES_PASSWORD=remote_claude

# Name of the database created on the container's first start.
RC_POSTGRES_DB=remote_claude

# Connection string used by the backend and by the migrations. Must agree with the three above.
DATABASE_URL=postgresql://remote_claude:remote_claude@localhost:5432/remote_claude

# --- OpenID Connect ------------------------------------------------------------------------
# No code knows the name of the provider: changing the issuer changes providers. Locally this
# points at the Keycloak realm; Auth0 is the same variables with other values
# (docs/architecture/shared/08-authentication.md).

# Issuer of the tokens. The backend discovers JWKS and endpoints from it. It is also the issuer the
# web signs in with, and the one whose token endpoint the backend calls on the browser's behalf.
OIDC_ISSUER=http://localhost:8180/realms/remote-claude

# Other issuers whose tokens the backend also accepts, comma-separated: the same realm reached
# through another origin, since the provider writes into `iss` the origin it was called through
# (ADR-021). Each gets its own discovery and key set; the audience is the same. Empty means none —
# OIDC_ISSUER alone. `pnpm dev` adds the realm through the web server
# (http://localhost:<RC_WEB_PORT>/realms/<realm>, the origin the phone uses over `adb reverse`) on
# its own, so leave it empty here unless another origin reaches the provider.
OIDC_ADDITIONAL_ISSUERS=

# Audience the backend requires in every access token it validates.
OIDC_AUDIENCE=https://api.remote-claude.local

# Public client the web front authenticates with (PKCE, no secret).
OIDC_CLIENT_ID_WEB=remote-claude-web

# Public client the Flutter app authenticates with (PKCE, no secret).
OIDC_CLIENT_ID_MOBILE=remote-claude-mobile

# The internal address the app's build offers on its address screen (plan 10, D-12): an origin, from
# which the API (/api), the socket (/ws) and the login (the realm's path) all derive. Empty is
# `pnpm dev:mobile`'s own web server, http://localhost:<RC_WEB_PORT>, over `adb reverse`.
RC_INTERNAL_URL=

# The external address of the same screen — the origin on the internet. Empty turns that radio off.
# Only https:// away from localhost (D-14).
RC_EXTERNAL_URL=

# This machine's address on the local network (plan 10, D-22): `pnpm dev` accepts the login through
# http://<it>:<RC_WEB_PORT>, and `pnpm mobile:install` builds the app's internal address with it.
# Empty is the private IPv4 of the first physical interface (Docker, bridges and VPNs skipped); set
# it when the machine is on two networks. Only 10/8, 172.16/12 or 192.168/16 (D-20).
RC_LAN_ADDRESS=

# Scopes requested at login. `offline_access` is what makes the refresh token possible.
OIDC_SCOPES="openid profile email offline_access"

# --- Public origin (`pnpm dev:public`) -------------------------------------------------------
# The HTTPS origin the tunnel publishes the stack at, e.g. https://name.ngrok-free.dev — or just
# the host. Read ONLY by `pnpm dev:public`: plain `pnpm dev` blanks it, so a value left here never
# turns the local stack public (docs/plans/18-dev-public/decisions.md, D-02). Empty means "the
# domain the tunnel account was given", which the run prints. The tunnel's authtoken does NOT go
# here — this file reaches the backend and the web whole. It goes in `.secrets/ngrok-authtoken`
# (ignored by git, `chmod 600`), which the run hands to the tunnel process alone.
RC_PUBLIC_URL=

# --- Runtime -------------------------------------------------------------------------------

# `development` | `test` | `production`. Decides log format and error detail.
NODE_ENV=development

# Level of the structured logger: trace | debug | info | warn | error | fatal.
# Every I/O crossing a boundary is logged at `debug` (docs/architecture/shared/03-logging.md).
LOG_LEVEL=debug

# --- Workspaces ----------------------------------------------------------------------------
# The allowlist of roots Claude may run in does NOT live in a variable: it lives in a file, so
# that changing it means having access to the machine and so that each root can carry a comment
# and its owners. The variable below only says where that file is
# (docs/plans/01-live-session/decisions.md#d-02).
#
# A file that is missing, unreadable, empty, malformed, or pointing at a root that does not exist
# stops the backend from starting. It is the first line of defence of the product: up with an
# allowlist nobody validated is worse than down.

# Path of the workspace allowlist file, absolute or relative to where the backend is started
# (`pnpm dev` resolves it against the repository).
#
# Left at this default, `pnpm dev` uses infra/workspace-allowlist.local.yaml instead whenever that
# file exists — the copy `pnpm allowlist add <folder>` writes, ignored by git, so the folders of
# your machine never end up in the repository. Set it to anything else and it wins over the copy
# (docs/plans/06-workbench/decisions.md#d-09).
RC_WORKSPACE_ALLOWLIST_FILE=./infra/workspace-allowlist.yaml

# Where the backend writes its pid — like the allowlist, `pnpm dev` resolves it against the
# repository — or `off` to write none.
# `pnpm allowlist add|remove` reads it to send the running backend `SIGHUP`, which reloads the
# allowlist without restarting anything (docs/plans/06-workbench/decisions.md#d-15).
RC_PID_FILE=./.run/backend.pid

# --- Sessions ------------------------------------------------------------------------------
# One session is one `query()` and one subprocess of the Claude CLI. A spike measured ~222 MB of
# RSS and exactly one process per session, growing linearly, so these numbers are measurements
# rather than guesses (docs/plans/01-live-session/decisions.md#d-05).

# How many sessions may run at once is **derived from the machine's RAM** at boot, not fixed:
# floor(RAM × RC_SESSION_MEMORY_FRACTION / RC_SESSION_MEMORY_MB), held between the floor and the
# ceiling below. A container's memory limit counts as the RAM when there is one. The session beyond
# the limit is refused with SESSION_LIMIT_REACHED, before anything is spawned — there is never an
# orphan (docs/plans/05-hardening-operations/decisions.md#f0--limites, D-01).

# The ceiling: never more than this many at once, however much RAM there is. Ten is ~2.2 GB.
RC_SESSION_MAX_CONCURRENT=10

# The floor: at least this many, however little RAM there is. Must not exceed the ceiling.
RC_SESSION_MIN_CONCURRENT=1

# Share of the machine's RAM the sessions may take together, between 0 and 1.
RC_SESSION_MEMORY_FRACTION=0.5

# What one session is assumed to cost, in MB. ~222 MB was measured; 256 leaves a margin.
RC_SESSION_MEMORY_MB=256

# How long a session may sit with nothing happening before it is closed and its subprocess freed.
# Counted from the last event of Claude or the last human action; a running turn or a pending
# permission is never idle, and a client merely attached does not keep it alive — it can be
# resumed from the history (D-02).
RC_SESSION_IDLE_TTL_MS=1800000

# How many turns one session may run before the SDK stops it.
RC_SESSION_MAX_TURNS=100

# Spend ceiling for one session, in US dollars.
RC_SESSION_MAX_BUDGET_USD=10

# Model a session opens with when the client asks for none.
RC_SESSION_DEFAULT_MODEL=claude-sonnet-5

# Permission mode a session opens with. `default` is the only one that asks a human about
# everything worth asking about; the others exist because the SDK has them.
RC_SESSION_DEFAULT_PERMISSION_MODE=default

# --- WebSocket limits ------------------------------------------------------------------------
# Per connection, and announced in `connection.ready` so a client learns them by being told rather
# than by being refused. Over the rate or the attached sessions → an `error` RATE_LIMITED with a
# `retryAfterSeconds`; doing it again inside that window closes the socket with 4429.

# Frames a client may send per second.
RC_WS_MAX_FRAMES_PER_SECOND=20

# Largest frame accepted, in bytes. Over it the frame is refused with PAYLOAD_TOO_LARGE.
RC_WS_MAX_FRAME_BYTES=65536

# Sessions one connection may be attached to at once.
RC_WS_MAX_ATTACHED_SESSIONS=16

# --- The Claude CLI's own configuration -----------------------------------------------------
# This one is NOT ours: the Claude CLI reads it, and the backend reads it for exactly one reason.
# Before opening a session the backend clears the directory's trust mark, because a **trusted**
# directory makes the CLI apply the project's `allow` rules and skip `canUseTool` entirely — no
# error, no warning, nobody asked (measured; see docs/plans/01-live-session/decisions.md#d-11).
# The mark lives in `.claude.json`, and when this variable is set the CLI keeps that file here
# instead of in the home directory — so the backend has to look in the same place, or it would
# clear a mark in a file the CLI is not reading.
#
# Leave it empty to use `~/.claude.json`, which is what a normal installation wants. The
# end-to-end runs set it to a throwaway directory so a test never edits somebody's own editor.
CLAUDE_CONFIG_DIR=

# The task list Claude keeps in a session — also the CLI's, not ours
# (docs/plans/08-claude-panel/decisions.md#d-25--a-lista-de-tarefas-todowrite-ou-task).
#
# Since CLI 2.1.268 the list is offered only to models up to Opus 4.7 / Sonnet 4.6 / Haiku 4.5.
# The backend therefore always starts the CLI with `CLAUDE_CODE_ENABLE_TODO_TOOLS=1`, so every
# model has one; that one is fixed in code and is not configured here.
#
# Which tool keeps the list is `CLAUDE_CODE_ENABLE_TASKS`, read by the CLI from the environment
# the backend passes on. The default — the variable absent — is the current form, which this
# product uses: `TaskCreate` / `TaskUpdate` / `TaskGet` / `TaskList`, one task at a time. Set it to
# `0` only to force the older `TodoWrite`, the whole list on every call. The panel draws either.
# CLAUDE_CODE_ENABLE_TASKS=0

# --- Permission ----------------------------------------------------------------------------
# `canUseTool` blocks the agent loop until somebody answers, and the CLI imposes no timeout of its
# own — measured, a permission sat open for 150 s without anything giving up. Ours is therefore
# the ONLY protection against a session that hangs for ever, which is why the client sends the
# command and never the number (docs/plans/01-live-session/decisions.md#d-09).

# How long a request waits for a human before the deadline denies it. Silence never authorises.
RC_PERMISSION_TIMEOUT_MS=120000

# How long a QUESTION of Claude (`AskUserQuestion`) waits for the person instead: reading and
# choosing take longer than yes or no, and the answer may come from a phone. Extended by the same
# step, to the same ceiling. When it passes, Claude is told the question was not answered, and to
# not assume an answer (docs/plans/24-structured-questions/decisions.md#f1--backend, D-07).
RC_QUESTION_TIMEOUT_MS=600000

# How much further out one extension pushes that deadline.
RC_PERMISSION_EXTENSION_MS=120000

# How many extensions one request may have. The ceiling is hard: reaching it is an error the UI
# shows, never a silent no-op that leaves a countdown looking extendable when it is not.
RC_PERMISSION_MAX_EXTENSIONS=3

# The longest a rule granted with scope `session` may live. Every rule expires; there is no
# permanent one. A session rule also dies with its session, whichever comes first.
RC_PERMISSION_RULE_LIFETIME_MS=28800000

# How long a rule granted with scope `project` or `always` lives when nobody said how long: 90
# days, the same horizon as the audit trail's retention — whoever reviews the quarter's trail also
# reviews what they authorised in the quarter (docs/plans/03-rules-and-audit/decisions.md#d-02).
# Must not be greater than the ceiling below, or the backend refuses to start.
RC_PERMISSION_RULE_DEFAULT_LIFETIME_MS=7776000000

# The longest such a rule may live. Asking for more is refused with PERMISSION_RULE_EXPIRY_TOO_LONG,
# never cut short in silence. Bounded in the code at 365 days: a value above it stops the boot.
RC_PERMISSION_RULE_MAX_LIFETIME_MS=7776000000

# --- Audit trail retention ------------------------------------------------------------------
# The trail keeps at least 90 days, and what is older is removed by a purge that records itself.
# The floor is not only here: the trigger of each trail table refuses a DELETE inside it, whatever
# this file says (docs/plans/03-rules-and-audit/F3-retention.md).

# How many days the trail is kept. At least 90: a value below that stops the backend from starting
# instead of being raised to it in silence. The purge deletes what is older.
RC_AUDIT_RETENTION_DAYS=90

# How often the backend's own job purges, in milliseconds, at least 60000. The first run is a
# minute after boot. `off` switches the job off — the only way to: 0, empty or missing stop the
# boot. Switched off, the backend warns at boot that the retention now depends on somebody running
# `pnpm db purge`.
RC_AUDIT_PURGE_INTERVAL_MS=86400000

# --- Push notifications --------------------------------------------------------------------
# How a permission request reaches somebody who is not at the browser. Three values, and no name
# of a provider anywhere else in the repository: changing provider is changing these three
# (docs/architecture/backend/03-modules.md#notification).
#
# Push is a best effort beside a deadline that is not. Unlike the workspace allowlist, a
# credentials file that is missing does NOT stop the boot: a backend that refused to start
# because nobody has set up notifications yet would trade the product for one of its
# conveniences. What it costs is said out loud in 02 · D-05 — a push that does not go out with
# nobody at the browser means the permission waits out the whole deadline with nobody knowing.

# Where a message is posted.
RC_PUSH_ENDPOINT=https://push.invalid/v1/messages:send

# The service account that signs the token exchange, as a FILE. Never a variable: a private key
# in an environment variable is a private key in every process listing and every crash dump.
# The file is never committed — `pnpm scan:secrets` is what enforces that.
RC_PUSH_CREDENTIALS_FILE=./.secrets/push-credentials.json

# What that exchange asks for.
RC_PUSH_SCOPE=https://push.invalid/auth/messaging

# --- Undo snapshots ------------------------------------------------------------------------
# Before a turn writes to a file, its previous contents are kept so the undo of a later plan can
# restore them. The SDK's own `rewindFiles()` cannot do this job: it overwrites edits the user
# made by hand, in silence, and it takes no file filter — so the store is ours
# (docs/architecture/backend/04-claude-integration.md#desfazer-arquivos--o-store-é-nosso).
#
# The database keeps the metadata; the contents go here, on disk. A row that pointed at a blob
# inside PostgreSQL would be a database that grows with somebody's repository.

# Where the snapshots live.
RC_CHECKPOINT_DIR=./.checkpoints

# Largest file that gets snapshotted, in bytes. Above it the checkpoint records that the path was
# NOT kept, so the undo knows it cannot promise that one instead of finding out too late.
RC_CHECKPOINT_MAX_FILE_BYTES=5242880

# How much the whole store may hold before the oldest sessions are purged. The purge never touches
# a session that is still running. Reference: the CLI's own store holds 6.6 MB for 54 sessions.
RC_CHECKPOINT_MAX_STORE_BYTES=524288000

# --- Explorer and editor -------------------------------------------------------------------
# The ceilings of the files of an open folder (plan 07). Provisional until measured: D-04 and D-10
# of docs/plans/07-explorer-and-editor/decisions.md say what to measure.

# Entries one level of the tree answers at most; past it the level says `truncated`.
RC_FILES_TREE_MAX_ENTRIES=5000

# Above this, a file opens in the light mode of the editor (no minimap, no folding).
RC_FILES_LARGE_FILE_BYTES=1048576

# Above this, a file is not opened for editing, and a save is refused (`FILE_TOO_LARGE`).
RC_FILES_MAX_EDIT_BYTES=10485760

# How many entries one copy may carry — counted before the first byte is copied.
RC_FILES_COPY_MAX_ENTRIES=10000

# How many bytes one copy may carry — measured before the first byte is copied.
RC_FILES_COPY_MAX_BYTES=104857600

# How far the count of a folder about to be deleted goes before it says "at least this many".
RC_FILES_DELETE_COUNT_CAP=10000

# How long the changes of a watched folder gather before they go out as one event, in ms.
RC_FILES_WATCH_WINDOW_MS=200

# The most changes one `workspace.filesChanged` carries; past it the event says `overflow`.
RC_FILES_WATCH_MAX_CHANGES=500

# How many folders one connection may follow at once (`WATCH_LIMIT_REACHED` past it).
RC_FILES_WATCH_MAX_PER_CONNECTION=16

# Bytes waiting on a socket past which its folder changes are held and owed as one `overflow`.
RC_FILES_WATCH_MAX_BUFFERED_BYTES=1048576

# --- Previews and transfer ------------------------------------------------------------------
# What a download, a zip and an upload may carry (plan 07, D-16). A download goes through the
# browser's memory as a blob, so its ceiling is what a phone holds — provisional until measured.
# The web reads these numbers from `GET /files/limits` before it starts.

# The most bytes one download takes out — a file, or the estimate of a zip, before the first byte.
RC_FILES_DOWNLOAD_MAX_BYTES=209715200

# The most entries one zip carries, counted before the first byte.
RC_FILES_ARCHIVE_MAX_ENTRIES=10000

# The largest file one upload writes.
RC_FILES_UPLOAD_MAX_BYTES=104857600

# The most files one upload writes — a folder sent with its structure counts each of them.
RC_FILES_UPLOAD_MAX_ENTRIES=1000

# The most bytes one upload writes, all files together. Not below RC_FILES_UPLOAD_MAX_BYTES.
RC_FILES_UPLOAD_MAX_TOTAL_BYTES=524288000

# --- Local history ---------------------------------------------------------------------------
# Before a write of yours loses a version of a file — a save, a delete, a restore, an upload that
# replaces — that version is kept here, so it can be compared and restored (plan 07, D-17). Claude's
# writes are not: the undo of the session keeps those. The database keeps the metadata; the
# contents go to this folder, one blob per distinct content.

# Where the versions live.
RC_FILES_HISTORY_DIR=./.file-history

# Largest file whose version is kept. Above it the history records that it was NOT kept, and why.
RC_FILES_HISTORY_MAX_FILE_BYTES=10485760

# The most versions kept of one file; the oldest goes first.
RC_FILES_HISTORY_MAX_PER_FILE=50

# How much the whole store may hold, in bytes of distinct contents, before the oldest go.
RC_FILES_HISTORY_MAX_STORE_BYTES=536870912

# How long a version is kept, in days.
RC_FILES_HISTORY_RETENTION_DAYS=30

# The most entries one delete keeps; a folder with more is deleted only with the definitive step.
RC_FILES_HISTORY_MAX_BATCH_ENTRIES=1000

# How recently a conversation begun elsewhere — the editor, a terminal — must have been written, in
# seconds, to be listed as "active elsewhere". An estimate: a long tool leaves the transcript
# unwritten for as long as it runs (40 s of Bash, 40 s of silence, measured — plan 08, D-06).
RC_TRANSCRIPT_ACTIVE_WINDOW_SECONDS=120

# The history read live (plan 22). The whole output of a tool, opened from its card, in bytes: above it
# the route serves the first and the last half, and says it cut (D-08).
RC_TRANSCRIPT_TOOL_RESULT_MAX_BYTES=262144
# The largest image of a prompt the history serves when someone opens it, in bytes; above it, 413 (D-10).
RC_TRANSCRIPT_IMAGE_MAX_BYTES=10485760
# How often a followed conversation is looked at, in milliseconds: while it is active elsewhere, and at
# rest — one look per conversation however many follow it, and a read only when it was written (D-11).
RC_TRANSCRIPT_FOLLOW_ACTIVE_MS=1000
# The same look at a conversation at rest — someone may take it up in the editor at any moment.
RC_TRANSCRIPT_FOLLOW_IDLE_MS=10000
# How many conversations one connection may follow; past it, TRANSCRIPT_FOLLOW_LIMIT.
RC_TRANSCRIPT_FOLLOW_MAX_PER_CONNECTION=4
# How many conversations the whole server follows at once; past it, TRANSCRIPT_FOLLOW_LIMIT.
RC_TRANSCRIPT_FOLLOW_MAX=16

# The composer of the panel (plan 08, F5). An image or a text file dropped from the desktop is an
# attachment held in memory for its session — never written to the folder, the trail or the log —
# up to this many bytes each: at most 5 MiB, what the model takes of one image (D-02).
RC_ATTACHMENT_MAX_BYTES=5242880
# How long an attachment is held, in seconds, if its session does not end first.
RC_ATTACHMENT_TTL_SECONDS=3600
# What all the attachments together may hold in memory; past it, the oldest go first.
RC_ATTACHMENT_MEMORY_BYTES=67108864
# The set of context warns past this share of the free context window, in percent — an estimate at
# ~4 bytes a token, provisional until it is measured (D-23). It warns; it never stops the send.
RC_CONTEXT_WARN_PERCENT=25
# The context window a draft estimates against, in tokens: before a session exists, there is no
# `getContextUsage()` to say the real one.
RC_CONTEXT_DRAFT_WINDOW_TOKENS=200000
# What the files of the set of context may add up to, in bytes, before the composer refuses to send.
RC_CONTEXT_MAX_BYTES=8388608
