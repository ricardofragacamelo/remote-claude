{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/packages/jscpd/schema.json",
  "threshold": 0,
  "minTokens": 30,
  "minLines": 5,
  "reporters": ["consoleFull"],
  "absolute": true,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.md",
    "packages/contracts/src/**",
    "web/src/shared/components/ui/**",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/migrations/**",
    "infra/**",
    "**/*.module.ts",
    "**/test/**",
    "**/e2e/fixtures/**",
    "packages/contracts/fixtures/**",
    "packages/contracts/schema/http/upload-preflight.schema.json",
    "packages/contracts/schema/http/upload-result.schema.json",
    "packages/contracts/schema/http/defaults-view.schema.json",
    "packages/contracts/schema/http/engines/claude/output-style-view.schema.json",
    "packages/contracts/schema/definitions/engine-capabilities.schema.json",
    "packages/contracts/schema/http/engine-models.schema.json",
    "packages/contracts/schema/definitions/component-version.schema.json",
    "packages/contracts/schema/definitions/read-version.schema.json"
  ]
}
