{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-claude.local/schema/http/history-page.json",
  "title": "HistoryPage",
  "description": "`GET /files/history`: a page of versions, newest first — one path's, the whole folder's, or the recently deleted (plan 07, B-58).",
  "x-kind": "http",
  "x-type": "files.history.page",
  "x-route": [{ "method": "GET", "path": "/files/history" }],
  "type": "object",
  "required": ["entries", "nextCursor"],
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "entryKind",
          "reason",
          "kept",
          "sizeBytes",
          "hash",
          "author",
          "at",
          "batchId"
        ],
        "description": "One version, as the Timeline shows it. Never the contents.",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Relative to the folder asked."
          },
          "entryKind": {
            "type": "string",
            "enum": ["file", "directory"]
          },
          "reason": {
            "type": "string",
            "enum": ["save", "delete", "restore", "upload"]
          },
          "kept": {
            "type": "string",
            "enum": ["yes", "tooLarge"]
          },
          "sizeBytes": {
            "type": "integer",
            "x-nullable": true
          },
          "hash": {
            "type": "string",
            "x-nullable": true,
            "description": "In the form of an `ETag`, so a client compares it with the current file's as it is."
          },
          "author": {
            "type": "object",
            "required": ["self", "id"],
            "description": "The server only knows the `sub` of whoever wrote: `self` says whether it is the caller.",
            "properties": {
              "self": {
                "type": "boolean"
              },
              "id": {
                "type": "string"
              }
            }
          },
          "at": {
            "type": "string",
            "description": "ISO-8601."
          },
          "batchId": {
            "type": "string",
            "x-nullable": true
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "x-nullable": true,
      "description": "Opaque to the client: send it back as `cursor`. `null` on the last page."
    }
  }
}
