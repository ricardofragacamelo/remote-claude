{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-claude.local/schema/http/recent-folders.json",
  "title": "RecentFolders",
  "description": "`GET /workspaces/recent`: the folders this caller opened, pinned first — each marked when it can no longer be used (plan 06).",
  "x-kind": "http",
  "x-type": "workspaces.recent",
  "x-route": [{ "method": "GET", "path": "/workspaces/recent" }],
  "type": "object",
  "required": ["folders"],
  "properties": {
    "folders": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["path", "rootLabel", "lastOpenedAt", "pinned", "available"],
        "properties": {
          "path": {
            "type": "string"
          },
          "rootLabel": {
            "type": "string",
            "x-nullable": true,
            "description": "The label of the root it lives under now, or `null` once it lives under none."
          },
          "lastOpenedAt": {
            "type": "string",
            "description": "ISO-8601."
          },
          "pinned": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean",
            "description": "`false` for a folder that left the allowlist or the disk — marked, rather than dropped."
          }
        }
      }
    }
  }
}
