{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS backend: the four layers, OIDC validation, Drizzle and the WebSocket gateway.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:arch": "depcruise src --config dependency-cruiser.config.mjs",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "verify": "node ../scripts/verify-workspace.mjs backend",
    "db": "tsx src/infrastructure/database/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-ws": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@remote-claude/config": "workspace:*",
    "@remote-claude/contracts": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.3.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
