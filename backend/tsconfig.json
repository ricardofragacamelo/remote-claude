{
  "$schema": "https://json.schemastore.org/tsconfig",

  // The aliases of tsconfig.base.json resolve against the baseUrl of whoever extends it, so this
  // workspace declares its own. See docs/plans/00-bootstrap/progress.md.
  //
  // The module setting is not a preference: `verbatimModuleSyntax` is inherited and rules
  // CommonJS out, and `Preserve` is what keeps extensionless specifiers and path aliases working
  // under `tsx`, which is what actually runs this process.
  //
  // `emitDecoratorMetadata` is deliberately OFF. Nest resolves a dependency by reflected type
  // only when it has that metadata; without it, every injected constructor parameter carries an
  // explicit `@Inject(TOKEN)`. That is the shape docs/architecture/backend/01-clean-architecture.md
  // asks for anyway — the token lives with the port, in `application/`.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "Preserve",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "types": ["node"],

    // The dependency-cruiser configuration is `.mjs` (the tool loads it itself, without a build)
    // and the architecture test imports it, so the rules under test are the ones the build uses.
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "*.ts",
    "*.mts",
    "*.mjs",
    "../scripts/lib/coverage.mjs"
  ]
}
