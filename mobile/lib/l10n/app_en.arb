  "connectionProblemScheme": "Only https:// addresses are accepted.",
  "@connectionProblemScheme": {"description": "Why the address cannot be saved"},
  "connectionProblemPlainText": "Only https:// is accepted here: http:// is for this phone itself (localhost) and, in the development app, for an IP of the local network (10.x, 172.16–31.x, 192.168.x), because the login would travel in clear text.",
  "@connectionProblemPlainText": {"description": "Why the address cannot be saved"},
  "connectionProblemPath": "Only the address of the server: nothing after the /.",
  "@connectionProblemPath": {"description": "Why the address cannot be saved"},
