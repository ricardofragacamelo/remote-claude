  "@sessionCloseTitle": {"description": "Title of the dialog that confirms ending the session"},
  "sessionCloseDescription": "Claude stops on this machine. What it wrote stays on disk, but the undo of its file changes goes with the session. The conversation stays in the history, and can be resumed.",
