<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the local stack of `pnpm dev` speaks plain HTTP, and Android refuses
     cleartext by default. The app's own calls go through Dart, which ignores that policy; the login
     does not — AppAuth fetches the discovery document and the token through the platform, and is
     refused with "Cleartext HTTP traffic to … not permitted".

     The stack is reached through this machine as `adb reverse` exposes it (`localhost`), or, in the
     build `pnpm mobile:install` puts on a phone, through its address on the local network. Android
     cannot name a range of addresses here, so cleartext is permitted to the platform as a whole, and
     the host is decided by the app: `checkOrigin` takes `http://` to the loopback and to the private
     network only (plan 10, D-20). Release builds never see this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
